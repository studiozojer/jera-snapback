# A dedicated service; Jera and the PDS keep their existing routes.
ansuz.jera.ink {
    tls force_automate
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        -Server
    }
    @oauth path /oauth/* /auth/refresh /m/archive
    handle @oauth {
        reverse_proxy 127.0.0.1:4433
    }
    @administration path /auth/session /auth/revoke /auth/delete-account
    handle @administration {
        respond "Not available" 403
    }
    handle {
        reverse_proxy 127.0.0.1:4431 {
            header_up -x-snapback-persona
        }
    }
}
